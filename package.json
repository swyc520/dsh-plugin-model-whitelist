{
  "name": "@swyc520/dsh-plugin-model-whitelist",
  "version": "0.1.0",
  "private": false,
  "description": "DeepSeek Harness plugin: whitelist which models appear in the composer model selector. 在 DSH 的模型选择器里按模型勾选显示/隐藏，未勾选的模型不再出现在列表中。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "model",
    "whitelist",
    "model-selector",
    "visibility"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swyc520/dsh-plugin-model-whitelist.git"
  },
  "bugs": {
    "url": "https://github.com/swyc520/dsh-plugin-model-whitelist/issues"
  },
  "homepage": "https://github.com/swyc520/dsh-plugin-model-whitelist#readme",
  "scripts": {
    "test": "node scripts/verify-client.mjs",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
